{
  "$shared": {
    "redirectNote": "Values for http/*.http. Copy to http-client.env.json (git-ignored). Put tokens in http-client.private.env.json (git-ignored)."
  },
  "lab": {
    "gateway": "https://<gateway-host>",
    "org": "<organization>",
    "tenant": "<tenant-id>",
    "clientId": "<public-client-id>",
    "token": "<az account get-access-token --scope https://mcp.dev.azure.com/.default>",
    "aigwToken": "<az account get-access-token --scope https://ai.gateway.azure.com/Data.All>",
    "aigwHost": "https://<ai-gateway-host>"
  }
}