// Tool-argument validation decisions (Application Insights traces) with proof that rejected
// calls never reached Azure DevOps (Log Analytics gateway log: no BackendUrl / BackendResponseCode).
// Optional: replace <run-id> with a probe run ID ("x-mcp-test-run"); left as is, all calls are shown.
let runId = "<run-id>";
let unfiltered = runId has "run-id";
let requestsInScope = AppRequests
    | where TimeGenerated > ago(1d)
    | where unfiltered or tostring(Properties["Request-x-mcp-test-run"]) == runId
    | project RequestId = Id, request = Name, ResultCode,
              apimRequestId = tostring(Properties["Response-x-apim-request-id"]);
let gateway = ApiManagementGatewayLogs
    | where TimeGenerated > ago(1d)
    | project CorrelationId, BackendUrl, BackendResponseCode;
AppTraces
| where TimeGenerated > ago(1d)
| where tostring(Properties["step"]) == "tool-validation"
| extend result = tostring(Properties["result"]), tool = tostring(Properties["tool"]),
         violations = tostring(Properties["violations"])
| join kind=inner requestsInScope on $left.ParentId == $right.RequestId
| join kind=leftouter gateway on $left.apimRequestId == $right.CorrelationId
| project TimeGenerated, result, tool, violations, request, ResultCode,
          reachedBackend = isnotempty(BackendUrl), BackendResponseCode, apimRequestId
| order by TimeGenerated asc
