// Shows the OAuth challenge the origin sent next to the one APIM returned to the client.
// Native MCP pass-through rewrites resource_metadata to the gateway; the HTTP proxy policy
// replaces it with APIM-hosted metadata.
ApiManagementGatewayLogs
| where TimeGenerated > ago(1d)
| where ResponseCode == 401
| extend backendChallenge = tostring(parse_json(BackendResponseHeaders)["WWW-Authenticate"]),
         clientChallenge = tostring(parse_json(ResponseHeaders)["WWW-Authenticate"])
| project TimeGenerated, ApiId, Url, backendChallenge, clientChallenge, CorrelationId
| order by TimeGenerated desc
