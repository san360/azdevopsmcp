{
  "$comment": "Gateway schema for the 'arguments' of tools/call core_list_projects (hosted Azure DevOps MCP). Curated from tools/list; stricter than the server: typed values, page size capped at 100, no unknown properties.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stateFilter": {
      "enum": [null, "all", "createPending", "deleted", "deleting", "new", "unchanged", "wellFormed", "All", "CreatePending", "Deleted", "Deleting", "New", "Unchanged", "WellFormed"]
    },
    "top": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
    "skip": { "type": ["integer", "null"], "minimum": 0, "maximum": 100000 },
    "continuationToken": { "type": ["string", "null"], "maxLength": 2048 },
    "orgName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,49}$" }
  }
}
