<!--
  POLICY  : proxy-mcp.xml (working setup; MCP data plane)
  PURPOSE : Policy of the working setup's APIM MCP server (native pass-through,
            listed under "MCP servers"). It forwards the caller's Entra token
            unchanged, so Azure DevOps authorizes every call as the signed-in
            user; APIM only governs the edge.
  RUNS ON : API "ado-mcp-proxy" (type mcp), every request to
            {gateway}/ado-mcp-proxy/{org} and {gateway}/ado-mcp-proxy (bare
            endpoint, tools then take orgName). First call of every sign-in (401)
            and every MCP message after it. The API has no operations.
  INPUT   : MCP Streamable HTTP request: JSON-RPC POST (initialize, tools/list,
            tools/call, notifications), or a body-less GET/DELETE.
  OUTPUT  : Forwarded by APIM to https://mcp.dev.azure.com/{org}; the SSE
            response streams back. APIM itself answers a 401 with
            resource_metadata="{gateway}/ado-mcp-proxy/.well-known/oauth-protected-resource/{org}";
            the API "ado-mcp-proxy-prm" (oauth-prm.xml) serves that URL, which is
            what makes sign-in work. Local answers: 400 (not HTTPS), 404 (unknown
            organization), 429 (rate limit).
  WHY     : MCP authorization 2025-06-18 and RFC 9728: the metadata must name an
            authorization server that accepts the gateway URL as resource; the
            OAuth facade under /ado-mcp-proxy/oauth does. Streamable HTTP: never
            read context.Response.Body here (it would buffer the SSE stream).
  VERIFY  : AppTraces steps proxy-inbound, proxy-outbound, proxy-error
            (docs/kql/policy-traces.kql); failures in docs/kql/errors.kql.
  STEPS   : inbound 1 HTTPS only, 2 organization (fragment mcp-org-validation),
            3 correlation id, 4 MCP method, 5 caller (fragment mcp-caller-identity),
            6 trace, 7 rate limit, 8 backend headers (fragment mcp-backend-headers).
            outbound: response headers (fragment mcp-response-headers), trace.
            No tool-argument validation: validate-content needs API operations
            and MCP servers have none (docs/TOOL-VALIDATION.md shows how to add it).
  FILLED  : by fill() in infra/modules/mcp-proxy.bicep (RATE_LIMIT_CALLS,
            RATE_LIMIT_PERIOD).
  DETAILS : docs/POLICIES.md
-->
<policies>
  <inbound>
    <base />
    <!-- Refuse plain HTTP: the bearer token would travel unencrypted. The API
         only lists https, so this is defence in depth. -->
    <choose>
      <when condition="@(context.Request.OriginalUrl.Scheme != &quot;https&quot;)">
        <return-response>
          <set-status code="400" reason="HTTPS Required" />
          <set-header name="Cache-Control" exists-action="override">
            <value>no-store</value>
          </set-header>
        </return-response>
      </when>
    </choose>
    <!-- Organization: sets variable org (from the path after the API path), or
         answers 404 {"error":"unknown_organization"} for a malformed or not
         allowed name (fragment, shared with oauth-prm.xml). -->
    <set-variable name="org-404-body" value="json" />
    <include-fragment fragment-id="mcp-org-validation" />
    <!-- Reuse a caller's X-Correlation-ID only if it is a GUID (no log
         injection); otherwise use the APIM request id. -->
    <set-variable name="correlation-id" value="@{
      var supplied = context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, &quot;&quot;);
      Guid parsed;
      return Guid.TryParse(supplied, out parsed) ? parsed.ToString(&quot;D&quot;) : context.RequestId.ToString(&quot;D&quot;);
    }" />
    <!-- JSON-RPC method for telemetry. Reading the request body is safe (requests
         are buffered, responses are not); preserveContent keeps it for
         forwarding. Body-less GET/DELETE and non-JSON bodies fall back to the
         HTTP method instead of failing. -->
    <set-variable name="mcp-method" value="@{
      try { var body = context.Request.Body?.As&lt;JObject&gt;(preserveContent: true); return body == null ? context.Request.Method : (string)body[&quot;method&quot;] ?? &quot;(response)&quot;; }
      catch { return context.Request.Method; }
    }" />
    <!-- Caller: variables caller-oid and caller-app-id from the token claims, for
         telemetry only (fragment, shared with native-mcp.xml). -->
    <include-fragment fragment-id="mcp-caller-identity" />
    <!-- Telemetry (AppTraces step proxy-inbound): MCP method, organization,
         correlation id, user oid and client app id. -->
    <trace source="ado-mcp-proxy" severity="information">
      <message>@("proxy inbound: " + (string)context.Variables["mcp-method"] + " org=" + ((string)context.Variables["org"] == "" ? "none" : (string)context.Variables["org"]) + " auth=" + (context.Request.Headers.ContainsKey("Authorization") ? "bearer" : "none"))</message>
      <metadata name="step" value="proxy-inbound" />
      <metadata name="mcpMethod" value="@((string)context.Variables[&quot;mcp-method&quot;])" />
      <metadata name="organization" value="@((string)context.Variables[&quot;org&quot;] == &quot;&quot; ? &quot;none&quot; : (string)context.Variables[&quot;org&quot;])" />
      <metadata name="correlationId" value="@((string)context.Variables[&quot;correlation-id&quot;])" />
      <metadata name="userOid" value="@((string)context.Variables[&quot;caller-oid&quot;])" />
      <metadata name="clientAppId" value="@((string)context.Variables[&quot;caller-app-id&quot;])" />
    </trace>
    <!-- Per client IP throttle: RATE_LIMIT_CALLS calls per RATE_LIMIT_PERIOD
         seconds, then 429 with Retry-After. Protects the backend and the user's
         Azure DevOps request budget. -->
    <rate-limit-by-key calls="__RATE_LIMIT_CALLS__" renewal-period="__RATE_LIMIT_PERIOD__" counter-key="@(&quot;ado-mcp|&quot; + context.Request.IpAddress)" retry-after-header-name="Retry-After" />
    <!-- Backend headers: strip spoofable forwarding, identity and trace headers;
         add X-MCP-Readonly / X-MCP-Toolsets from named values (fragment, shared
         with native-mcp.xml). -->
    <include-fragment fragment-id="mcp-backend-headers" />
    <!-- Pass the correlation id to Azure DevOps as well. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;correlation-id&quot;])</value>
    </set-header>
  </inbound>
  <backend>
    <!-- The MCP server forwards to its backend (ado-mcp-origin, the bare host
         https://mcp.dev.azure.com) and appends /{org} from the client path. -->
    <base />
  </backend>
  <outbound>
    <base />
    <!-- Cache-Control: no-store and x-apim-request-id (fragment). -->
    <include-fragment fragment-id="mcp-response-headers" />
    <!-- Echo the correlation id for support and log lookup. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;correlation-id&quot;])</value>
    </set-header>
    <!-- Telemetry (AppTraces step proxy-outbound): status code per MCP method.
         Uses the status only, never context.Response.Body (would buffer SSE). -->
    <trace source="ado-mcp-proxy" severity="information">
      <message>@("proxy outbound: " + (string)context.Variables["mcp-method"] + " status " + context.Response.StatusCode)</message>
      <metadata name="step" value="proxy-outbound" />
      <metadata name="statusCode" value="@(context.Response.StatusCode.ToString())" />
      <metadata name="correlationId" value="@((string)context.Variables[&quot;correlation-id&quot;])" />
    </trace>
  </outbound>
  <on-error>
    <base />
    <!-- Telemetry (AppTraces step proxy-error) with the policy that failed
         (LastError.Source). docs/kql/errors.kql shows the gateway side. -->
    <trace source="ado-mcp-proxy" severity="error">
      <message>@("proxy error: " + (context.LastError == null ? "" : context.LastError.Reason + " " + context.LastError.Message))</message>
      <metadata name="step" value="proxy-error" />
      <metadata name="source" value="@(context.LastError == null || string.IsNullOrEmpty(context.LastError.Source) ? &quot;none&quot; : context.LastError.Source)" />
    </trace>
    <include-fragment fragment-id="mcp-response-headers" />
    <!-- GetValueOrDefault: the error can occur before correlation-id was set. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;correlation-id&quot;, context.RequestId.ToString(&quot;D&quot;)))</value>
    </set-header>
  </on-error>
</policies>